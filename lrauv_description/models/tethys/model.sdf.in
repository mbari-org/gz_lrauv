<?xml version="1.0"?>
<!--
  Development of this module has been funded by the Monterey Bay Aquarium
  Research Institute (MBARI) and the David and Lucile Packard Foundation
-->

<!--
  This model uses an FSK / FRD body frame:
    X forward, Y starboard, Z down.
  When spawning into Gazebo's ENU world, apply the fixed NED -> ENU rotation
  once so zero attitude points North with Z down.

  The base_link ORIGIN is the vehicle centre of mass, NOT the CAD/mesh origin.
  It sits 0.53630306 m FORWARD (+X) of the CAD origin, so every fixed point on
  the hull has an X coordinate 0.53630306 m smaller here than its CAD value.
  base_link is purely the PHYSICS frame: Gazebo requires <fluid_added_mass> and
  the Hydrodynamics plugin coefficients to be referenced to the link origin.

  The vehicle NAV frame is NOT this frame.  It is the CTD inlet port, where the
  CAD origin is defined, and is what the LRAUV Main Vehicle Application means by
  "vehicle position".  tethys_equipped/model.sdf offsets its <include> of this model
  by the same 0.53630306 m so that the enclosing MODEL frame origin stays on the
  CTD inlet.  Keep those two numbers in sync: if body_cad_centroid changes, the
  nav_to_body offset in tethys_equipped/model.sdf must change with it.

  The acoustic_transponder link stays at the CAD origin (x = -0.53630306), i.e.
  co-located with the nav origin, and remains the range-bearing / ENU reference.
-->

@{
total_mass = 147.5671
buoyancy_z_offset = -0.007
fluid_density = 1025
base_link_dx = 2.0
base_link_dy = 0.4

battery_mass = 31.7307

drop_weight_mass = 1.0

fin_mass = 0.089896
propeller_mass = 0.098986
buoyancy_engine_mass = 0.3
acoustic_transponder_mass = 0.01

neutral_buoyancy_dq1 = 0.1
neutral_buoyancy_dq2 = 0.1

# Centre of mass of the base_link body structure, excluding all separately-
# modelled links (battery, drop_weight, fins, propeller, buoyancy_engine,
# acoustic_transponder).  Obtained from CAD mass-properties analysis; the
# <inertia> values below are also computed about this point.
#
# Expressed in the ORIGINAL (CAD / mesh) base_link frame.  The link origin is
# now placed here, so in the emitted SDF this point is the origin itself and
# every other authored CAD coordinate is offset by -link_origin_shift; see
# below.  This quantity is what all such coordinates are measured from, so it
# stays in CAD coordinates.
#
# SDFormat requires <inertia> to be expressed in the inertial frame whose
# origin is the CoM (i.e. the frame given by <inertial><pose>).  Using the CAD
# centroid keeps the tensor consistent with its reference frame; an earlier
# template derived the inertial pose from a balance formula that put the CoM
# 683 mm away from the true structural CoM, the bug documented for
# dorado.sdf.in.
body_cad_centroid = [0.53630306, 0, 0, 0, 0, 0]

# The base_link origin is placed ON the vehicle centre of mass.
#
# Both the <fluid_added_mass> matrix below and the damping / Coriolis
# coefficients of the Hydrodynamics plugin were derived about the CoM, but
# Gazebo does NOT reference either of them to <inertial><pose>:
#   * DART requires <fluid_added_mass> to be expressed about the LINK ORIGIN,
#   * the Hydrodynamics plugin reads the body twist at the link origin and
#     applies its wrench there.
# So a CoM-referenced coefficient set is silently interpreted as
# origin-referenced.  The added mass could be re-referenced by a 6x6
# congruence, but the dominant crossflow-drag damping (yVabsV, nRabsR,
# mQabsQ, ...) cannot be exactly re-expressed in the coefficient basis of the
# plugin -- the |v + d*r| crossflow kink has no representation in the
# {v|v|, r|r|, ...} terms.  The exact fix is therefore to move the link origin
# onto the CoM so that every authored coefficient is correct as-written, with
# no transform.
#
# Every pose expressed in the base_link frame is shifted by
# -link_origin_shift in X.  Child-frame poses (the inertial / collision /
# visual poses inside each fin and propeller link, and the LiftDrag <cp>
# values) are already relative to their own link and are left untouched.
link_origin_shift = body_cad_centroid[0]

def shift_to_com(pose):
    """Re-express a base_link-frame pose about the new (CoM) link origin."""
    shifted = list(pose)
    shifted[0] = round(shifted[0] - link_origin_shift, 9)
    return shifted

component_mass = battery_mass + drop_weight_mass
base_link_mass = total_mass - component_mass
# CoM is now the link origin, so the inertial pose is identity.
base_link_inertial_pose = shift_to_com(body_cad_centroid)
base_link_visual_pose = shift_to_com([0, 0, 0, 0, 0, 0])
main_body_buoyancy_pose = shift_to_com(
    [body_cad_centroid[0], 0, buoyancy_z_offset, 0, 0, 0])
base_link_dz = total_mass / (base_link_dx * base_link_dy * fluid_density)

elevator_stbd_pose = shift_to_com([-0.49001, 0.10036, 0, 90.0, 0, 0])
rudder_upper_pose = shift_to_com([-0.49001, 0, -0.10036, 0, 0, 0])
propeller_pose = shift_to_com([-0.86045, 0, 0, 0, 0, 0])
battery_inertial_pose = shift_to_com([0.556, 0, 0, 0, 0, 0])
buoyancy_engine_pose = shift_to_com([-0.137, 0, 0, 0, 0, 0])
drop_weight_pose = shift_to_com([-0.128, 0, 0, 0, 0, 0])
acoustic_transponder_pose = shift_to_com([0, 0, 0, 180, 0, 90])

def neutral_buoyancy_size(mass):
    dq3 = mass / (neutral_buoyancy_dq1 * neutral_buoyancy_dq2 * fluid_density)
    return dq3
# [neutral_buoyancy_dx, neutral_buoyancy_dy, dz]

def fmt(value):
    if isinstance(value, (list, tuple)):
        return " ".join(f"{token:.15g}" for token in value)
    return f"{value:.15g}"
}@

<sdf version="1.11">
  <model name="tethys">
    <enable_wind>true</enable_wind>

    <!-- Body -->
    <link name="base_link">
      <inertial>
        <!-- CoM of base_link body (battery + drop_weight excluded).  The link
             origin has been moved onto body_cad_centroid, so this pose is
             identity; the inertia tensor is still the CAD tensor about the CoM. -->
        <pose>@(fmt(base_link_inertial_pose))</pose>
        <mass>@(fmt(base_link_mass))</mass>
        <inertia>
          <ixx>3.000000</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>41.980233</iyy>
          <iyz>0</iyz>
          <izz>41.980233</izz>
        </inertia>
        <!-- wrong naming convention -->
        <!--fluid_added_mass>
          <kp>0.000000</kp>
          <kv>0.000000</kv>
          <mq>33.463086</mq>
          <mw>-7.117842</mw>
          <nr>33.463086</nr>
          <nv>7.117842</nv>
          <xu>4.876161</xu>
          <yp>0.000000</yp>
          <yr>7.117842</yr>
          <yv>126.324739</yv>
          <zq>-7.117842</zq>
          <zw>126.324739</zw>
        </fluid_added_mass-->
        <!-- DART expects this about the LINK ORIGIN and does not apply
             <inertial><pose> to it.  These coefficients were derived about the
             CoM, which is now the link origin, so they are correct as-written
             and must NOT be transformed. -->
        <fluid_added_mass>
          <xx>4.876161</xx>
          <yy>126.324739</yy>
          <yr>7.117842</yr>
          <zz>126.324739</zz>
          <zq>-7.117842</zq>
          <qq>33.463086</qq>
          <rr>33.463086</rr>
        </fluid_added_mass>
      </inertial>

      <collision name="main_body_buoyancy">
        <pose>@(fmt(main_body_buoyancy_pose))</pose>
        <geometry>
          <box>
            <size>@(fmt([base_link_dx, base_link_dy, base_link_dz]))</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <!-- Mesh is authored about the old base_link origin; keep it physically
             put now that the link origin sits on the CoM. -->
        <pose>@(fmt(base_link_visual_pose))</pose>
        <geometry>
          <mesh>
            <uri>meshes/auv_body.gltf</uri>
          </mesh>
        </geometry>
        <!-- <material>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/Tethys_Albedo.png</albedo_map>
              <normal_map>materials/textures/Tethys_Normal.png</normal_map>
              <metalness_map>materials/textures/Tethys_Metalness.png</metalness_map>
              <roughness_map>materials/textures/Tethys_Roughness.png</roughness_map>
            </metal>
          </pbr>
          <script>
            <uri>materials/scripts/</uri>
            <uri>materials/textures/</uri>
            <name>tethys/Tethys_Diffuse</name>
          </script>
        </material> -->
      </visual>
    </link>

    <!-- Elevator assembly (starboard + port) -->
    <link name="elevator_stbd">
      <pose relative_to="base_link" degrees="true">@(fmt(elevator_stbd_pose))</pose>
      <inertial>
        <pose>-0.008245 0 0.10036 0 0 0</pose>
        <mass>@(fmt(2.0 * fin_mass))</mass>
        <inertia>
          <ixx>0.005762519936</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.005821261036</iyy>
          <iyz>0</iyz>
          <izz>0.000061102178</izz>
        </inertia>
      </inertial>

      <collision name="elevator_stbd_buoyancy">
        <geometry>
          <box>
            <size>@(fmt([neutral_buoyancy_dq1, neutral_buoyancy_size(fin_mass), neutral_buoyancy_dq2]))</size>
          </box>
        </geometry>
      </collision>

      <collision name="elevator_port_buoyancy">
        <pose degrees="true">0 0 0.20072 180 0 0</pose>
        <geometry>
          <box>
            <size>@(fmt([neutral_buoyancy_dq1, neutral_buoyancy_size(fin_mass), neutral_buoyancy_dq2]))</size>
          </box>
        </geometry>
      </collision>

      <visual name="elevator_stbd_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/rudder.STL</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <!-- <pbr>
            <metal>
              <albedo_map>materials/textures/Tethys_Albedo.png</albedo_map>
              <normal_map>materials/textures/Tethys_Normal.png</normal_map>
              <metalness_map>materials/textures/Tethys_Metalness.png</metalness_map>
              <roughness_map>materials/textures/Tethys_Roughness.png</roughness_map>
            </metal>
          </pbr>
          <script>
            <uri>materials/scripts/</uri>
            <uri>materials/textures/</uri>
            <name>tethys/Tethys_Diffuse</name>
          </script> -->
        </material>
      </visual>

      <visual name="elevator_port_visual">
        <pose degrees="true">0 0 0.20072 180 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/rudder.STL</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <!-- <pbr>
            <metal>
              <albedo_map>materials/textures/Tethys_Albedo.png</albedo_map>
              <normal_map>materials/textures/Tethys_Normal.png</normal_map>
              <metalness_map>materials/textures/Tethys_Metalness.png</metalness_map>
              <roughness_map>materials/textures/Tethys_Roughness.png</roughness_map>
            </metal>
          </pbr>
          <script>
            <uri>materials/scripts/</uri>
            <uri>materials/textures/</uri>
            <name>tethys/Tethys_Diffuse</name>
          </script> -->
        </material>
      </visual>
    </link>

    <!-- Rudder assembly (upper + lower) -->
    <link name="rudder_upper">
      <pose relative_to="base_link">@(fmt(rudder_upper_pose))</pose>
      <inertial>
        <pose>-0.008245 0 0.10036 0 0 0</pose>
        <mass>@(fmt(2.0 * fin_mass))</mass>
        <inertia>
          <ixx>0.005762519936</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.005821261036</iyy>
          <iyz>0</iyz>
          <izz>0.000061102178</izz>
        </inertia>
      </inertial>

      <collision name="rudder_upper_buoyancy">
        <geometry>
          <box>
            <size>@(fmt([neutral_buoyancy_dq1, neutral_buoyancy_size(fin_mass), neutral_buoyancy_dq2]))</size>
          </box>
        </geometry>
      </collision>

      <collision name="rudder_lower_buoyancy">
        <pose degrees="true">0 0 0.20072 180 0 0</pose>
        <geometry>
          <box>
            <size>@(fmt([neutral_buoyancy_dq1, neutral_buoyancy_size(fin_mass), neutral_buoyancy_dq2]))</size>
          </box>
        </geometry>
      </collision>

      <visual name="rudder_upper_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/rudder.STL</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <!-- <pbr>
            <metal>
              <albedo_map>materials/textures/Tethys_Albedo.png</albedo_map>
              <normal_map>materials/textures/Tethys_Normal.png</normal_map>
              <metalness_map>materials/textures/Tethys_Metalness.png</metalness_map>
              <roughness_map>materials/textures/Tethys_Roughness.png</roughness_map>
            </metal>
          </pbr>
          <script>
            <uri>materials/scripts/</uri>
            <uri>materials/textures/</uri>
            <name>tethys/Tethys_Diffuse</name>
          </script> -->
        </material>
      </visual>

      <visual name="rudder_lower_visual">
        <pose degrees="true">0 0 0.20072 180 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/rudder.STL</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <!-- <pbr>
            <metal>
              <albedo_map>materials/textures/Tethys_Albedo.png</albedo_map>
              <normal_map>materials/textures/Tethys_Normal.png</normal_map>
              <metalness_map>materials/textures/Tethys_Metalness.png</metalness_map>
              <roughness_map>materials/textures/Tethys_Roughness.png</roughness_map>
            </metal>
          </pbr>
          <script>
            <uri>materials/scripts/</uri>
            <uri>materials/textures/</uri>
            <name>tethys/Tethys_Diffuse</name>
          </script> -->
        </material>
      </visual>
    </link>

    <!-- Propeller -->
    <link name="propeller">
      <pose relative_to="base_link">@(fmt(propeller_pose))</pose>
      <inertial>
        <pose>-0.020426 0.000003 -0.000001 0 0 0</pose>
        <mass>@(fmt(propeller_mass))</mass>
        <inertia>
          <ixx>0.000116947629</ixx>
          <ixy>0.000000001573</ixy>
          <ixz>-0.000000001220</ixz>
          <iyy>0.000034471703</iyy>
          <iyz>0.000019923561</iyz>
          <izz>0.000118241998</izz>
        </inertia>
      </inertial>

      <collision name="propeller_buoyancy">
        <geometry>
          <box>
            <size>@(fmt([neutral_buoyancy_size(propeller_mass), neutral_buoyancy_dq1, neutral_buoyancy_dq2]))</size>
          </box>
        </geometry>
      </collision>

      <visual name= "visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/prop.STL</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <!-- <pbr>
            <metal>
              <albedo_map>materials/textures/Tethys_Albedo.png</albedo_map>
              <normal_map>materials/textures/Tethys_Normal.png</normal_map>
              <metalness_map>materials/textures/Tethys_Metalness.png</metalness_map>
              <roughness_map>materials/textures/Tethys_Roughness.png</roughness_map>
            </metal>
          </pbr>
          <script>
            <uri>materials/scripts/</uri>
            <uri>materials/textures/</uri>
            <name>tethys/Tethys_Diffuse</name>
          </script> -->
        </material>
      </visual>
    </link>

    <!-- Battery -->
    <!-- No separate collision for battery, because it is inside the vehicle.
         Additional collision requires buoyancy volume recalculation. -->
    <link name="battery">
      <!--TODO: On hold till mesh center adjusted to aft dome, then it will be
           0.563, 0, 0.024 in CAD coordinates (i.e. pass that through
           shift_to_com, as the 0.556 below is).-->
      <pose relative_to="base_link">@(fmt(battery_inertial_pose))</pose>
      <inertial>
        <!-- Non-zero y creates roll. Not fun to tune without actual base link inertia minus battery-->
        <mass>@(fmt(battery_mass))</mass>
        <inertia>
          <ixx>0.2327</ixx>
          <ixy>0</ixy>
          <ixz>-0.0004</ixz>
          <iyy>1.0930</iyy>
          <iyz>0</iyz>
          <izz>1.0344</izz>
        </inertia>
      </inertial>

      <visual name= "visual">
        <geometry>
          <box>
            <size>0.6489446 0.24638 0.17415</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.0 0.0 1.0 1.0</diffuse>
          <specular>0.0 0.0 1.0 1.0</specular>
        </material>
      </visual>
    </link>

    <link name="buoyancy_engine">
      <!-- TODO: Determine location of buoyancy engine -->
      <pose relative_to="base_link">@(fmt(buoyancy_engine_pose))</pose>

      <!-- TODO: Remove inertial and collision

         This link was originally given inertia because Gazebo would segfault
         with links without inertia. To counter this mass, a volume (collision)
         was added, which adds buoyancy.

         Gazebo doesn't have this limitation anymore, so both the inertia and
         collision could be removed. However, it looks like the link's weight
         and buoyancy aren't cancelling each other out precisely at the moment
         (why?), so removing them makes the vehicle unstable.

      -->
      <inertial>
        <mass>@(fmt(buoyancy_engine_mass))</mass>
        <inertia>
          <ixx>0.000143971303</ixx>
          <ixy>0.000000000008</ixy>
          <ixz>-0.000000000224</ixz>
          <iyy>0.000140915448</iyy>
          <iyz>-0.000025236433</iyz>
          <izz>0.000033571862</izz>
        </inertia>
      </inertial>
      <collision name="buoyancy_engine">
        <geometry>
          <box>
            <size>@(fmt([neutral_buoyancy_dq1, neutral_buoyancy_dq2, neutral_buoyancy_size(buoyancy_engine_mass)]))</size>
          </box>
        </geometry>
      </collision>
    </link>

    <link name="acoustic_transponder">
      <!-- This link creates an ENU reference frame from the FSK base link.
           Kept at the old base_link origin so the nav / range-bearing
           reference point stays physically put. -->
      <pose degrees="true">@(fmt(acoustic_transponder_pose))</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>@(fmt(acoustic_transponder_mass))</mass>
        <inertia>
          <ixx>0.000143971303</ixx>
          <ixy>0.000000000008</ixy>
          <ixz>-0.000000000224</ixz>
          <iyy>0.000140915448</iyy>
          <iyz>-0.000025236433</iyz>
          <izz>0.000033571862</izz>
        </inertia>
      </inertial>
      <collision name="acoustic_transponder_col">
        <geometry>
          <box>
            <size>@(fmt([neutral_buoyancy_dq1, neutral_buoyancy_dq2, neutral_buoyancy_size(acoustic_transponder_mass)]))</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Joints -->
    <joint name="acoustic_transponder_joint" type="fixed">
      <pose>0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>acoustic_transponder</child>
    </joint>
    <joint name="buoyancy_engine_joint" type="fixed">
      <pose>0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>buoyancy_engine</child>
    </joint>

    <joint name="elevator_stbd_joint" type="revolute">
      <pose relative_to="base_link" degrees="true">@(fmt(elevator_stbd_pose))</pose>
      <parent>base_link</parent>
      <child>elevator_stbd</child>
      <axis>
        <xyz>0 0 -1</xyz>
        <dynamics>
          <damping>0.01</damping>
          <friction>0.001</friction>
        </dynamics>
        <limit>
          <lower>-0.3</lower>
          <upper>0.3</upper>
          <effort>inf</effort>
          <!-- Physical fin: ~30 deg in 4 s => 7.5 deg/s = 0.13090 rad/s -->
          <!--velocity>0.13090</velocity-->
        </limit>
      </axis>
    </joint>

    <joint name="rudder_upper_joint" type="revolute">
      <pose relative_to="base_link">@(fmt(rudder_upper_pose))</pose>
      <parent>base_link</parent>
      <child>rudder_upper</child>
      <axis>
        <xyz>0 0 1</xyz>
        <dynamics>
          <damping>0.01</damping>
          <friction>0.001</friction>
        </dynamics>
        <limit>
          <lower>-0.3</lower>
          <upper>0.3</upper>
          <effort>inf</effort>
          <!-- Physical fin: ~30 deg in 4 s => 7.5 deg/s = 0.13090 rad/s -->
          <!--velocity>0.13090</velocity-->
        </limit>
      </axis>
    </joint>

    <joint name="propeller_joint" type="revolute">
      <pose relative_to="base_link">@(fmt(propeller_pose))</pose>
      <parent>base_link</parent>
      <child>propeller</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1e+12</lower>
          <upper>1e+12</upper>
          <effort>1e6</effort>
          <!-- 1.5 m/s / 0.0318309 m/rad ~= 47.1239 rad/s -->
          <velocity>47.1239</velocity>
        </limit>
      </axis>
    </joint>

    <!-- positive joint values move mass forward -->
    <joint name="battery_joint" type="prismatic">
      <pose relative_to="base_link">@(fmt(battery_inertial_pose))</pose>
      <parent>base_link</parent>
      <child>battery</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <!-- TODO(andermi) WORKAROUND FOR KNOWN BUG IN GZ SIM -->
          <lower>-0.035</lower>
          <upper>0.035</upper>
          <effort>1e6</effort>
          <!--effort>inf</effort-->
          <!--velocity>0.0007</velocity-->
          <!-- <velocity>1</velocity> -->
        </limit>
      </axis>
    </joint>

    <!-- Drop weight -->
    <link name="drop_weight">
      <pose relative_to="base_link">@(fmt(drop_weight_pose))</pose>
      <inertial>
        <mass>@(fmt(drop_weight_mass))</mass>
        <inertia>
