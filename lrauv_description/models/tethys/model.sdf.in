<?xml version="1.0"?>
<!--
  Development of this module has been funded by the Monterey Bay Aquarium
  Research Institute (MBARI) and the David and Lucile Packard Foundation
-->

<!--
  This model uses an FSK / FRD body frame:
    X forward, Y starboard, Z down.
  When spawning into Gazebo's ENU world, apply the fixed NED -> ENU rotation
  once so zero attitude points North with Z down.

  base_link ORIGIN is the vehicle centre of mass, not the CAD/mesh origin: it is
  the PHYSICS frame, because Gazebo references <fluid_added_mass> and the
  Hydrodynamics coefficients to the link origin.  Every CAD coordinate below is
  therefore offset by -body_cad_centroid.

  The NAV frame (CAD origin) is separate: tethys_equipped/model.sdf offsets its
  <include> of this model by +body_cad_centroid so the enclosing MODEL frame
  origin stays on the CAD origin.  Keep those two numbers in sync.

  See JOURNAL.md for the reasoning.
-->

@{
total_mass = 1015.587701
buoyancy_z_offset = -0.05
fluid_density = 1025
base_link_dx = 5.2
base_link_dy = 0.533

battery_mass = 31.7307

drop_weight_mass = 1.0

tailcone1_mass = 0.433
tailcone2_mass = 4.482
propeller_mass = 0.339
buoyancy_engine_mass = 0.3
acoustic_transponder_mass = 0.01

# Expressed in the ORIGINAL (CAD / mesh) base_link frame.  The link origin is now
# placed here, so in the emitted SDF this point is the origin itself and every
# other authored CAD coordinate is offset by -link_origin_shift.
body_cad_centroid = [2.73898254, 1.33322978e-05, -1.26695777e-04, 0, 0, 0]

# base_link origin placed ON the CoM, so the CoM-referenced <fluid_added_mass>
# and Hydrodynamics coefficients are correct as-written.  Gazebo references both
# to the LINK ORIGIN and ignores <inertial><pose>, so a CoM-referenced set was
# being read as origin-referenced: a 2.74 m frame error.  See JOURNAL.md.
#
# All three components are shifted, so <inertial><pose> becomes exactly identity.
# Poses relative to a CHILD link (the tailcone gimbal chain, the propeller, every
# child inertial / collision / visual pose, and the LiftDrag cp) are already in
# the child frame and are left untouched.
link_origin_shift = body_cad_centroid[:3]

def shift_to_com(pose):
    shifted = list(pose)
    for i in range(3):
        shifted[i] = shifted[i] - link_origin_shift[i]
    return shifted

neutral_buoyancy_dx = 0.1
neutral_buoyancy_dy = 0.1

separate_link_mass = (
  battery_mass
  + drop_weight_mass
  + tailcone1_mass
  + tailcone2_mass
  + propeller_mass
  + buoyancy_engine_mass
  + acoustic_transponder_mass)
base_link_mass = total_mass - separate_link_mass
main_body_buoyant_mass = base_link_mass + battery_mass + drop_weight_mass
# CoM is now the link origin, so the inertial pose is identity.
base_link_inertial_pose = shift_to_com(body_cad_centroid)
base_link_visual_pose = shift_to_com([0, 0, 0, 0, 0, 0])
main_body_buoyancy_x = 2.730003535115409
main_body_buoyancy_pose = shift_to_com([
  main_body_buoyancy_x,
  0,
  body_cad_centroid[2] + buoyancy_z_offset,
  0,
  0,
  0])
base_link_dz = main_body_buoyant_mass / (base_link_dx * base_link_dy * fluid_density)

tailcone1_pose = shift_to_com([0, 0, 0, 0, 0, 0])
battery_inertial_pose = shift_to_com([2.536, 0, 0, 0, 0, 0])
buoyancy_engine_pose = shift_to_com([-0.137, 0, 0, 0, 0, 0])
drop_weight_pose = shift_to_com([0.128, 0, 0, 0, 0, 0])
acoustic_transponder_pose = shift_to_com([0, 0, 0, 180, 0, 90])

def neutral_buoyancy_size(mass):
    dz = mass / (neutral_buoyancy_dx * neutral_buoyancy_dy * fluid_density)
    return [neutral_buoyancy_dx, neutral_buoyancy_dy, dz]

def fmt(value):
    if isinstance(value, (list, tuple)):
        return " ".join(f"{token:.15g}" for token in value)
    return f"{value:.15g}"
}@

<sdf version="1.11">
  <model name="tethys">
    <enable_wind>true</enable_wind>

    <!-- Body -->
    <link name="base_link">
      <inertial>
        <!-- Link origin moved onto body_cad_centroid, so this pose is identity;
             the inertia tensor is still the CAD tensor about the CoM. -->
        <pose>@(fmt(base_link_inertial_pose))</pose>
        <!-- 146.5671 subtracted by battery mass -->
        <mass>@(fmt(base_link_mass))</mass>
        <!--<mass>146.5671</mass>-->
        <!-- TODO: Get inertial matrix of base link WITHOUT battery -->
        <inertia>
          <ixx>32.0</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1757.802554</iyy>
          <iyz>0</iyz>
          <izz>1757.802554</izz>
        </inertia>
        <!-- SDF 1.11 wants MATRIX-entry names (xx yy zz pp qq rr plus off-diagonals),
             not the Fossen derivative names this block used: xu, yv, zw, mq, nr, kp,
             kv, mw and nv are unknown to sdformat and were silently discarded, while
             yr, zq and yp are legal and so were parsed with the derivative sign.  Net
             effect was a zero diagonal plus two sign-flipped couplings.  Names mapped
             xu to xx, yv to yy, zw to zz, mq to qq, nr to rr; values negated because
             M_A is the positive-definite added-mass matrix, i.e. minus the derivatives.
             Referenced to the LINK ORIGIN, which is now the CoM, so used as-written. -->
        <fluid_added_mass>
          <xx>26.133175</xx>
          <yy>970.290157</yy>
          <yr>98.390533</yr>
          <zz>970.290157</zz>
          <zq>-98.390533</zq>
          <qq>1541.634893</qq>
          <rr>1541.634893</rr>
        </fluid_added_mass>
      </inertial>

      <collision name="main_body_buoyancy">
        <pose>@(fmt(main_body_buoyancy_pose))</pose>
        <geometry>
          <box>
            <size>@(fmt([base_link_dx, base_link_dy, base_link_dz]))</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <!-- Mesh is authored about the CAD origin; keep it physically put. -->
        <pose>@(fmt(base_link_visual_pose))</pose>
        <geometry>
          <mesh>
            <uri>meshes/dorado/Dorado_Gazebo_CAD_Mapper1/AUV_BODY/AUV_BODY.gltf</uri>
          </mesh>
        </geometry>
        <!-- <material>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/Tethys_Albedo.png</albedo_map>
              <normal_map>materials/textures/Tethys_Normal.png</normal_map>
              <metalness_map>materials/textures/Tethys_Metalness.png</metalness_map>
              <roughness_map>materials/textures/Tethys_Roughness.png</roughness_map>
            </metal>
          </pbr>
          <script>
            <uri>materials/scripts/</uri>
            <uri>materials/textures/</uri>
            <name>tethys/Tethys_Diffuse</name>
          </script>
        </material> -->
      </visual>
    </link>

    <!-- Elevator assembly (starboard + port), moved to the tailcone gimbal -->
    <link name="tailcone1_elevator">
      <!-- Gimbal sits at the CAD origin.  The rest of the chain
           (tailcone2_rudder, propeller) is posed relative to this link. -->
      <pose relative_to="base_link" degrees="true">@(fmt(tailcone1_pose))</pose>
      <inertial>
        <pose>-0.000188794464 -0.001283443690 0.000000073961538 0 0 0</pose>
        <mass>@(fmt(tailcone1_mass))</mass>
        <inertia>
          <ixx>0.003872666790000</ixx>
          <ixy>0.000012025632700</ixy>
          <ixz>-0.000000005550018</ixz>
          <iyy>0.002126378970000</iyy>
          <iyz>-0.000000023404624</iyz>
          <izz>0.002075473960000</izz>
        </inertia>
      </inertial>

      <collision name="tailcone1_buoyancy">
        <geometry>
          <box>
            <size>@(fmt(neutral_buoyancy_size(tailcone1_mass)))</size>
          </box>
        </geometry>
      </collision>

      <visual name="tailcone1_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/dorado/Dorado_Gazebo_CAD_Mapper1/TAILCONE1/TAILCONE1.gltf</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
        </material>
      </visual>
    </link>

    <!-- Rudder assembly (upper + lower), moved to the tailcone gimbal -->
    <link name="tailcone2_rudder">
      <pose relative_to="tailcone1_elevator">0 0 0 0 0 0</pose>
      <inertial>
        <pose>-0.114408906000 -0.000001093452 0.000009130530 0 0 0</pose>
        <mass>@(fmt(tailcone2_mass))</mass>
        <inertia>
          <ixx>0.101689528000000</ixx>
          <ixy>0.000000063634077</ixy>
          <ixz>-0.000001560126430</ixz>
          <iyy>0.067756292200000</iyy>
          <iyz>-0.000000012796612</iyz>
          <izz>0.067760960200000</izz>
        </inertia>
      </inertial>

      <collision name="tailcone2_buoyancy">
        <geometry>
          <box>
            <size>@(fmt(neutral_buoyancy_size(tailcone2_mass)))</size>
          </box>
        </geometry>
      </collision>

      <visual name="tailcone2_visual">
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/dorado/Dorado_Gazebo_CAD_Mapper1/TAILCONE2/TAILCONE2.gltf</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
        </material>
      </visual>
    </link>

    <!-- Propeller -->
    <link name="propeller">
      <pose relative_to="tailcone2_rudder">-0.137922253 0 0 0 0 0</pose>
      <inertial>
        <pose>-0.0387989966e 0.000003 0.0000004 0 0 0</pose>
        <mass>@(fmt(propeller_mass))</mass>
        <inertia>
          <ixx>0.000116947629</ixx>
          <ixy>0.000000001573</ixy>
          <ixz>-0.000000001220</ixz>
          <iyy>0.000034471703</iyy>
          <iyz>0.000019923561</iyz>
          <izz>0.000118241998</izz>
        </inertia>
      </inertial>

      <collision name="propeller_buoyancy">
        <geometry>
          <box>
            <size>@(fmt(neutral_buoyancy_size(propeller_mass)))</size>
          </box>
        </geometry>
      </collision>

      <visual name= "visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/dorado/Dorado_Gazebo_CAD_Mapper1/PROP/PROP.gltf</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <!-- <pbr>
            <metal>
              <albedo_map>materials/textures/Tethys_Albedo.png</albedo_map>
              <normal_map>materials/textures/Tethys_Normal.png</normal_map>
              <metalness_map>materials/textures/Tethys_Metalness.png</metalness_map>
              <roughness_map>materials/textures/Tethys_Roughness.png</roughness_map>
            </metal>
          </pbr>
          <script>
            <uri>materials/scripts/</uri>
            <uri>materials/textures/</uri>
            <name>tethys/Tethys_Diffuse</name>
          </script> -->
        </material>
      </visual>
    </link>

    <!-- Battery -->
    <!-- No separate collision for battery, because it is inside the vehicle.
         Additional collision requires buoyancy volume recalculation. -->
    <link name="battery">
      <!--TODO: On hold till mesh center adjusted to aft dome, then it will be 0.563, 0, 0.024.-->
      <pose relative_to="base_link">@(fmt(battery_inertial_pose))</pose>
      <inertial>
        <!-- Non-zero y creates roll. Not fun to tune without actual base link inertia minus battery-->
        <mass>@(fmt(battery_mass))</mass>
        <inertia>
          <ixx>0.2327</ixx>
          <ixy>0</ixy>
          <ixz>-0.0004</ixz>
          <iyy>1.0930</iyy>
          <iyz>0</iyz>
          <izz>1.0344</izz>
        </inertia>
      </inertial>

      <visual name= "visual">
        <geometry>
          <box>
            <size>0.6489446 0.24638 0.17415</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.0 0.0 1.0 1.0</diffuse>
          <specular>0.0 0.0 1.0 1.0</specular>
        </material>
      </visual>
    </link>

    <link name="buoyancy_engine">
      <!-- TODO: Determine location of buoyancy engine -->
      <pose relative_to="base_link">@(fmt(buoyancy_engine_pose))</pose>

      <!-- TODO: Remove inertial and collision

         This link was originally given inertia because Gazebo would segfault
         with links without inertia. To counter this mass, a volume (collision)
         was added, which adds buoyancy.

         Gazebo doesn't have this limitation anymore, so both the inertia and
         collision could be removed. However, it looks like the link's weight
         and buoyancy aren't cancelling each other out precisely at the moment
         (why?), so removing them makes the vehicle unstable.

      -->
      <inertial>
        <mass>@(fmt(buoyancy_engine_mass))</mass>
        <inertia>
          <ixx>0.000143971303</ixx>
          <ixy>0.000000000008</ixy>
          <ixz>-0.000000000224</ixz>
          <iyy>0.000140915448</iyy>
          <iyz>-0.000025236433</iyz>
          <izz>0.000033571862</izz>
        </inertia>
      </inertial>
      <collision name="buoyancy_engine">
        <geometry>
          <box>
            <size>@(fmt(neutral_buoyancy_size(buoyancy_engine_mass)))</size>
          </box>
        </geometry>
      </collision>
    </link>

    <link name="acoustic_transponder">
      <!-- ENU reference frame from the FSK base link.  Kept at the CAD origin,
           co-located with the nav origin. -->
      <pose degrees="true">@(fmt(acoustic_transponder_pose))</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>@(fmt(acoustic_transponder_mass))</mass>
        <inertia>
          <ixx>0.000143971303</ixx>
          <ixy>0.000000000008</ixy>
          <ixz>-0.000000000224</ixz>
          <iyy>0.000140915448</iyy>
          <iyz>-0.000025236433</iyz>
          <izz>0.000033571862</izz>
        </inertia>
      </inertial>
      <collision name="acoustic_transponder_col">
        <geometry>
          <box>
            <size>@(fmt(neutral_buoyancy_size(acoustic_transponder_mass)))</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Joints -->
    <joint name="acoustic_transponder_joint" type="fixed">
      <pose>0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>acoustic_transponder</child>
    </joint>
    <joint name="buoyancy_engine_joint" type="fixed">
      <pose>0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>buoyancy_engine</child>
    </joint>

    <joint name="elevator_stbd_joint" type="revolute">
      <pose relative_to="tailcone1_elevator" degrees="true">0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>tailcone1_elevator</child>
      <axis>
        <xyz>0 1 0</xyz>
        <dynamics>
          <damping>0.01</damping>
          <friction>0.001</friction>
        </dynamics>
        <limit>
          <lower>-0.3</lower>
          <upper>0.3</upper>
          <effort>inf</effort>
          <!-- Physical fin: ~30 deg in 4 s => 7.5 deg/s = 0.13090 rad/s -->
          <!--velocity>0.13090</velocity-->
        </limit>
      </axis>
    </joint>

    <joint name="rudder_upper_joint" type="revolute">
      <pose relative_to="tailcone2_rudder" degrees="true">-0.0254 0 0 0 0 0</pose>
      <parent>tailcone1_elevator</parent>
      <child>tailcone2_rudder</child>
      <axis>
        <xyz>0 0 1</xyz>
        <dynamics>
          <damping>0.01</damping>
          <friction>0.001</friction>
        </dynamics>
        <limit>
          <lower>-0.3</lower>
          <upper>0.3</upper>
          <effort>inf</effort>
          <!-- Physical fin: ~30 deg in 4 s => 7.5 deg/s = 0.13090 rad/s -->
          <!--velocity>0.13090</velocity-->
        </limit>
      </axis>
    </joint>

    <joint name="propeller_joint" type="revolute">
      <pose relative_to="propeller">0 0 0 0 0 0</pose>
      <parent>tailcone2_rudder</parent>
      <child>propeller</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1e+12</lower>
          <upper>1e+12</upper>
          <effort>1e6</effort>
          <!-- 1.5 m/s / 0.05 m/rad = 30 rad/s -->
          <velocity>30</velocity>
        </limit>
      </axis>
    </joint>

    <!-- positive joint values move mass forward -->
    <joint name="battery_joint" type="prismatic">
      <pose relative_to="base_link">@(fmt(battery_inertial_pose))</pose>
      <parent>base_link</parent>
      <child>battery</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <!-- TODO(andermi) WORKAROUND FOR KNOWN BUG IN GZ SIM -->
          <lower>-0.035</lower>
          <upper>0.035</upper>
          <!--effort>1e6</effort-->
          <effort>inf</effort>
          <!--velocity>0.0007</velocity-->
          <!-- <velocity>1</velocity> -->
        </limit>
      </axis>
    </joint>

    <!-- Drop weight -->
    <link name="drop_weight">
      <pose relative_to="base_link">@(fmt(drop_weight_pose))</pose>
      <inertial>
        <mass>@(fmt(drop_weight_mass))</mass>
        <inertia>
          <ixx>0.000143971303</ixx>
          <iyy>0.000140915448</iyy>
          <izz>0.000033571862</izz>
        </inertia>
      </inertial>
    </link>
  </model>
</sdf>
